{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "파일 열기·저장 대화상자와 사용자가 고른 파일/앱 데이터 폴더 읽기·쓰기",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }, { "path": "$HOME/**" }, { "path": "$APPDATA/**" }, { "path": "$APPDATA" }]
    }, "opener:default"
  ]
}
